# 通知用 Telegram Bot の APIトークン。このシステム専用に BotFather で /newbot して発行する。
TELEGRAM_BOT_TOKEN=

# リマインドの送信先 chat_id(自分との個人チャット、またはグループ)。
# 専用botなので webhook 未登録 = getUpdates が使える。調べ方:
#   1. 送信先が個人チャットなら bot に1通送信 / グループなら bot を招待して何か発言
#   2. curl "https://api.telegram.org/bot<token>/getUpdates"
#   3. レスポンスの result[].message.chat.id
# グループの chat_id は "-100..." の形になる。
TELEGRAM_GOMI_CHAT_ID=

# 送信失敗時にアラートを送る先(任意。未設定ならスキップ)
TELEGRAM_STAFF_ALERT_CHAT_ID=

# 日次バッチ(/api/cron/gomi)を Vercel Cron 以外から叩かれないようにする秘密文字列
CRON_SECRET=
