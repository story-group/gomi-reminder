# ------------------------------------------------------------
# Telegram
# ------------------------------------------------------------
# 通知用BotのAPIトークン(BotFatherで /newbot して取得)
TELEGRAM_BOT_TOKEN=
# リマインドの送信先chat_id(個人チャット、またはグループ。グループは -100… の形)
TELEGRAM_GOMI_CHAT_ID=
# 送信に失敗したときにアラートを送る先(任意。未設定ならアラート送信をスキップ)
TELEGRAM_STAFF_ALERT_CHAT_ID=

# ------------------------------------------------------------
# 日次バッチ
# ------------------------------------------------------------
# /api/cron/gomi をVercel Cron以外から叩かれないようにする秘密文字列(任意のランダム文字列)
# Vercelでは同名の環境変数を設定しておくと、Cron実行時に自動でこの値が付与される
CRON_SECRET=
